# Local development only: do not commit real secrets
DATABASE_URL=postgres://agentone:agentone@127.0.0.1:5432/agentone?sslmode=disable
PORT=8080
DATA_PATH=server/data/store.json
OPENROUTER_API_KEY=
JWT_SECRET=
GROQ_API_KEY=
AI_PROVIDER=rule_based
AI_MODEL=llama-3.3-70b-versatile
AI_MODEL_FAST=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_ENABLED=true
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.3

# Account Security (P5.1A)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
EMAIL_VERIFICATION_TTL_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_SENDER_MODE=development
APP_PUBLIC_URL=http://localhost:8080

# Yandex OAuth
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/yandex/callback
OAUTH_STATE_TTL=10m
